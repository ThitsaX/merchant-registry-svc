# Local Docker Compose configuration. Copy this file to .env before starting.
COMPOSE_PROJECT_NAME=merchant-registry-demo

# Host ports
BACKEND_HOST_PORT=5555
FRONTEND_HOST_PORT=5173
ORACLE_HOST_PORT=8888
MYSQL_HOST_PORT=3306
MINIO_HOST_PORT=9100

# Public browser URLs. Replace 127.0.0.1/localhost for remote access.
APP_URL=http://127.0.0.1:5555
FRONTEND_SET_PASSWORD_URL=http://localhost:5173/set-password
VITE_API_URL=http://127.0.0.1:5555/api/v1

# Local defaults: no Google reCAPTCHA and no third-party email service.
RECAPTCHA_ENABLED=false
VITE_RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
VITE_RECAPTCHA_SITE_KEY=
EMAIL_PROVIDER=none
EMAIL_FROM=
SENDGRID_API_KEY=

# Local service credentials. Replace these outside local development.
JWT_SECRET=local-demo-jwt-secret-change-me
MYSQL_ROOT_PASSWORD=password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
REGISTRY_INTERNAL_API_KEY=change-me

# Dependency images can be overridden when a registry or platform requires it.
MYSQL_IMAGE=mysql:8.0.46
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
