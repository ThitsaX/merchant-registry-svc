{
  "name": "@mojaloop/merchant-acquirer-backend",
  "version": "1.0.5",
  "description": "Merchant Acquirer Backend",
  "main": "dist/src/index.js",
  "private": true,
  "mojaloop": {
    "publish_to_dockerhub": true
  },
  "scripts": {
    "prestart": "npm run build -w shared-lib",
    "start": "ts-node src/index.ts",
    "prestart:watch": "npm run build -w shared-lib",
    "start:watch": "nodemon --watch 'src/**/*.ts' --watch '.env*' --exec 'ts-node' src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint:fix": "npm run lint -- --fix",
    "lint:check": "eslint . --ext .js,.ts",
    "type:check": "tsc --noEmit",
    "dep:check": "npx ncu -e 2",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects 'Unit Tests'",
    "test:integration": "jest --runInBand --selectProjects 'Integration Tests'",
    "test:e2e": "jest --runInBand --selectProjects 'E2E Tests'",
    "test:verbose": "jest --runInBand --verbose",
    "test:debug": "jest --runInBand --detectOpenHandles",
    "test:coverage": "jest --runInBand --coverage",
    "format": "prettier --write \"src/**/*.{js,ts,css,md}\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sendgrid/mail": "^8.1.0",
    "axios": "^1.18.1",
    "base64url": "^3.0.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "currency-codes": "^2.2.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "i18n-iso-countries": "^7.14.0",
    "iso-3166-2": "^1.0.0",
    "js-yaml": "^4.3.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.18.1",
    "logform": "^2.6.1",
    "minio": "^8.0.7",
    "morgan": "^1.11.0",
    "ms": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.8",
    "qrcode": "^1.5.3",
    "reflect-metadata": "^0.1.13",
    "shared-lib": "file:../shared-lib",
    "sharp": "^0.35.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^0.3.31",
    "uuid": "^11.1.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.0",
    "@commitlint/config-conventional": "^18.4.0",
    "@jest/reporters": "^29.7.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash": "^4.14.201",
    "@types/morgan": "^1.9.9",
    "@types/ms": "^0.7.34",
    "@types/multer": "^1.4.10",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^2.0.16",
    "@types/swagger-jsdoc": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "8.56.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-standard-with-typescript": "^39.1.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^16.3.0",
    "eslint-plugin-promise": "^6.1.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.0.2",
    "nodemon": "^3.0.1",
    "npm-check-updates": "^22.2.9",
    "prettier": "^3.0.3",
    "sqlite3": "^5.1.7",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  }
}
