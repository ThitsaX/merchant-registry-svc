{
  "name": "@mojaloop/merchant-registry-oracle",
  "version": "1.0.5",
  "description": "Merchant Registry Oracle",
  "main": "dist/src/index.js",
  "private": true,
  "mojaloop": {
    "publish_to_dockerhub": true
  },
  "scripts": {
    "prestart": "npm run build -w shared-lib",
    "start": "nodemon --watch 'src/**/*.ts' --watch '.env*' --exec 'ts-node' src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint:check": "eslint . --ext .js,.ts",
    "type:check": "tsc --noEmit",
    "dep:check": "npx ncu -e 2",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand --selectProjects 'Integration Tests'",
    "test:e2e": "jest --runInBand --selectProjects 'E2E Tests'",
    "test:verbose": "jest --runInBand --verbose",
    "test:debug": "jest --runInBand --detectOpenHandles",
    "test:coverage": "jest --runInBand --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "base64url": "^3.0.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "js-yaml": "^4.3.0",
    "lodash": "^4.18.1",
    "logform": "^2.6.1",
    "morgan": "^1.11.0",
    "mysql2": "^3.9.8",
    "reflect-metadata": "^0.1.13",
    "shared-lib": "file:../shared-lib",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^0.3.31",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.14.201",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.0.0",
    "@types/supertest": "^2.0.16",
    "@types/swagger-jsdoc": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "8.56.0",
    "eslint-config-standard-with-typescript": "^39.1.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^16.3.0",
    "eslint-plugin-promise": "^6.1.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.0.2",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  }
}
