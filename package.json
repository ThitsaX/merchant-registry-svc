    "node": ">=24.18.0 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/base64url": "^2.0.3",
    "audit-ci": "^7.1.0"
  }
