NODE_ENV=development
APP_URL=http://localhost:5555 # for email verification
HOST=0.0.0.0
PORT=5555

# Frontend URL for Email Verification Redirect
FRONTEND_SET_PASSWORD_URL=http://localhost:5173/set-password

JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
RECAPTCHA_SECRET_KEY=change-me
RECAPTCHA_ENABLED=false

# Client Secret key generation to be used by External DFSP to access oracle
API_KEY_LENGTH=64
API_KEY_PREFIX=MR

# MYSQL DB CONFIG
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=merchant_acquirer_user
DB_PASSWORD=change-me
DB_DATABASE=merchant_acquirer_db

# Registry Oracle internal API
REGISTRY_ORACLE_URL=http://127.0.0.1:8888
REGISTRY_INTERNAL_API_KEY=change-me # Use the same strong secret in both services
REGISTRY_HTTP_TIMEOUT_MS=5000
REGISTRY_HTTP_RETRIES=2

# EMVCo merchant-presented QR
EMVCO_MERCHANT_ACCOUNT_GUI=org.mojaloop

# S3/Minio Config
S3_ENDPOINT=localhost
S3_PORT=9000 # 443 for https AWS S3
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_REGION=us-east-1 # Not required for Minio.. Minio will ignore it.
S3_USE_SSL=false # set to true if using https AWS S3
S3_MERCHANT_BUCKET_NAME=merchant-documents
S3_DFSP_LOGO_BUCKET_NAME=dfsp-logos

# Optional email provider. "none" keeps all core user flows email-independent.
# To use SendGrid, set EMAIL_PROVIDER=sendgrid and configure both values below.
EMAIL_PROVIDER=none
EMAIL_FROM=
SENDGRID_API_KEY=

# Optional seed data
SEED_DEFAULT_DFSP_USERS=false
SEED_DEFAULT_HUB_USERS=false

# Rate limits
GENERAL_RATE_LIMIT_WINDOW=15m
GENERAL_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW=1h
AUTH_RATE_LIMIT_MAX=10
FORGOT_PASSWORD_RATE_LIMIT_WINDOW=1h
FORGOT_PASSWORD_RATE_LIMIT_MAX=3

# Optional GLEIF API override
GLEIF_API_URL=https://api.gleif.org/api/v1
GLEIF_API_KEY=

LOG_PATH=./logs
LOG_LEVEL=info
LOG_DISABLED=false
